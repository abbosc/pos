# ── Required ──────────────────────────────────────────────────────────────────
# Your domain or subdomain. Its DNS A record must point to this server's IP.
DOMAIN=kofe.example.com

# Password to log in to the app. Use something long.
ADMIN_PASSWORD=change-me

# Random secrets. Generate each with:  openssl rand -hex 32
SESSION_SECRET=
POSTGRES_PASSWORD=

# ── Optional ──────────────────────────────────────────────────────────────────
# Telegram notifications (daily cash close summary, low stock alerts).
# Create a bot with @BotFather, add it to your group, then get the chat id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How many days of nightly backups to keep on the server.
BACKUP_KEEP_DAYS=30
